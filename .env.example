# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
PORT=8787

# Optional: per-IP rate limiting on /api/study-set and /api/refine.
# Leave these unset and rate limiting is off (fine for local dev).
# Free Redis database: https://console.upstash.com (or Vercel's Upstash integration,
# which sets KV_REST_API_URL / KV_REST_API_TOKEN instead — either pair works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Requests allowed per IP per window. Window uses Upstash syntax: "60 s", "10 m", "1 h".
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60 s
