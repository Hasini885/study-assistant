{
  "name": "study-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Paste notes, get AI-generated flashcards and a quiz you can actually study with.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "concurrently -n server,client -c magenta,cyan \"npm:start:server\" \"npm:start:client\"",
    "dev": "npm start",
    "start:server": "node backend/server.js",
    "start:client": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node --test \"backend/tests/**/*.test.js\"",
    "test:frontend": "vitest run --config frontend/vite.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
